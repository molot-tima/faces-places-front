# Base URL for the real backend API
VITE_API_BASE_URL=https://example.com

# Enable mock API (MSW intercepts fetch requests in the browser)
# Set to "false" to use real backend at VITE_API_BASE_URL
VITE_MOCK_API=true

# Enable fake Telegram user for browser dev (outside Telegram WebView)
VITE_DEV_FAKE_TELEGRAM_USER=true
